# v1.3.1 final-image TP4 example overrides.
# Edit paths/devices, then: set -a; source examples/tp4.env.example; set +a
# and run: ./scripts/launch.sh tp4

IMAGE=qwen38-k100ai-int8:v1.3.1
PORT=8068
SERVED_MODEL_NAME=Qwen3.8-27B-W8A8-DFlash2-TP4
NAME=qwen38-tp4

# Host GPU mapping example: physical GPU4-7.
HOST_GPU_IDS="4 5 6 7"
RENDER_DEVICES="/dev/dri/renderD132 /dev/dri/renderD133 /dev/dri/renderD134 /dev/dri/renderD135"

# Weights: change to your real paths.
TARGET_MODEL=/data/my_models/Qwen/Qwen3.8-27B-SmoothQuant-W8A8-INT8
DRAFT_MODEL=/data/qwen38-dflash2-k100ai/models/Qwen3.8-27B-DFlash2

# Verified TP4 runtime defaults.
CONTEXT_LENGTH=262144
MEM_FRACTION_STATIC=0.95
MAX_RUNNING_REQUESTS=8
PP_MAX_MICRO_BATCH_SIZE=8
MAX_TOTAL_TOKENS=1048576
CHUNKED_PREFILL_SIZE=16384
MAX_PREFILL_TOKENS=16384
MAMBA_TRACK_INTERVAL=16384
MAX_MAMBA_CACHE_SIZE=32
SPECULATIVE_NUM_DRAFT_TOKENS=8
SGLANG_EMPTY_CACHE_INTERVAL=60
