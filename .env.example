# Copy to .env and change only paths/device nodes for your server.
# Online/default: leave BASE_IMAGE commented out.
# Offline server after `docker load`: set BASE_IMAGE=qwen38-sourcefind-base:20260620
# BASE_IMAGE=qwen38-sourcefind-base:20260620
TARGET_MODEL=/data/models/Qwen3.8-27B-SmoothQuant-W8A8-INT8
DRAFT_MODEL=/data/models/Qwen3.8-27B-DFlash2
RENDER0=/dev/dri/renderD132
RENDER1=/dev/dri/renderD133
RENDER2=/dev/dri/renderD134
RENDER3=/dev/dri/renderD135
PORT=8068

# v1.0 longctx-v8 Champion profile (default, formal cold 10/10):
U036_PROFILE=ranklocal_bm64_w4_preloadv
U036_SPLIT_KV=4
CUSTOM_AR=1

# Set CUSTOM_AR=0 only if your server's topology/driver stack cannot use the
# validated custom all-reduce path; doing so is outside the published v1.0 authority.
