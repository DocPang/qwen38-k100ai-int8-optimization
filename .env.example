# Copy to .env and change paths/device nodes for your server.
# v1.1.0 series profiles: tp1 / tp2 / tp4
PROFILE=tp4

# Online/default: leave BASE_IMAGE commented out.
# Offline server after `docker load`: set BASE_IMAGE=qwen38-sourcefind-base:20260620
# BASE_IMAGE=qwen38-sourcefind-base:20260620

TARGET_MODEL=/data/models/Qwen3.8-27B-SmoothQuant-W8A8-INT8
DRAFT_MODEL=/data/models/Qwen3.8-27B-DFlash2

# Fill the render nodes in the order you want this container to own.
# TP1 uses RENDER0; TP2 uses RENDER0-1; TP4 uses RENDER0-3.
# The placeholders below are intentionally invalid so run.sh fails closed until you replace them.
RENDER0=/dev/dri/REPLACE_ME_RENDER0
RENDER1=/dev/dri/REPLACE_ME_RENDER1
RENDER2=/dev/dri/REPLACE_ME_RENDER2
RENDER3=/dev/dri/REPLACE_ME_RENDER3

# Leave PORT empty to use the profile default: TP1=8090, TP2=8062, TP4=8068.
PORT=
IMAGE_TAG=qwen38-k100ai-int8-series:local
# CONTAINER_NAME=

# Validated defaults. Change only when your topology requires it.
CUSTOM_AR=1
P2P=1
